#!/bin/bash
#WHATIS: Cytoscape network visualization platform (VNC)
#NCPUS: 3
#MEM: 16G
#TIME: 8:00:00
#REQUIRED_OVERLAYS: xfce4 openjdk/{CONDA_OPENJDK} cytoscape/{CYTOSCAPE}
#BIND: $CNT_HELPER_STATE_DIR/vnc:$HOME/.vnc

#PARAM: CYTOSCAPE=? --cytoscape,-C "Cytoscape version"
#AUTOUPDATE:CYTOSCAPE:github:cytoscape/cytoscape>=3.9.0
#VALUE: CYTOSCAPE=3.10.4,3.10.3,3.10.2,3.10.1,3.10.0,3.9.1,3.9.0

#PARAM: CONDA_OPENJDK=? --openjdk,-j "OpenJDK version (must be 17.x)"
#VALUE: CONDA_OPENJDK=17.0.18,17.0.17,17.0.15,17.0.14,17.0.13,17.0.11,17.0.10,17.0.9,17.0.8,17.0.7.4,17.0.5.8,17.0.3
#AUTOUPDATE:CONDA_OPENJDK:conda-forge:openjdk>=17.0.2<18

#PARAM: VNC_PROVIDER=kasm --vnc,-v "VNC provider"
#VALUE: VNC_PROVIDER=kasm | turbo

# Check if 127.0.0.1:$1 is accepting TCP connections. Uses bash's /dev/tcp
# redirection instead of `nc` — these images don't install netcat.
_port_open() {
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# 1. Desktop dirs always under SCRATCH to protect HOME quota.
DESKTOP_HOME="${SCRATCH:-$HOME}/desktop-home"
mkdir -p "$HOME/.config"
cat > "$HOME/.config/user-dirs.dirs" <<EOT
XDG_DESKTOP_DIR="$DESKTOP_HOME/Desktop"
XDG_DOCUMENTS_DIR="$DESKTOP_HOME/Documents"
XDG_DOWNLOAD_DIR="$DESKTOP_HOME/Downloads"
XDG_MUSIC_DIR="$DESKTOP_HOME/Music"
XDG_PICTURES_DIR="$DESKTOP_HOME/Pictures"
XDG_PUBLICSHARE_DIR="$DESKTOP_HOME/Public"
XDG_TEMPLATES_DIR="$DESKTOP_HOME/Templates"
XDG_VIDEOS_DIR="$DESKTOP_HOME/Videos"
EOT
mkdir -p "$DESKTOP_HOME"/{Desktop,Documents,Downloads,Music,Pictures,Public,Templates,Videos}

# 2. xstartup — per-id in state dir.
cat > "$CNT_HELPER_STATE_DIR/xstartup" <<'EOF'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
exec dbus-launch --exit-with-session startxfce4
EOF
chmod +x "$CNT_HELPER_STATE_DIR/xstartup"

# 3. XDG_RUNTIME_DIR — per-id to avoid dbus conflicts between sessions.
export XDG_RUNTIME_DIR="$CNT_JOB_TMPDIR/xdg_runtime"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# 4. glib schemas — compile into per-job share dir (wiped by Slurm/cleanup; avoids quota).
SCHEMA_DIR="$CNT_JOB_TMPDIR/share/glib-2.0/schemas"
mkdir -p "$SCHEMA_DIR"
cp -r /usr/share/glib-2.0/schemas/* "$SCHEMA_DIR/" 2>/dev/null || true
glib-compile-schemas "$SCHEMA_DIR" 2>/dev/null || true
export XDG_DATA_DIRS="$CNT_JOB_TMPDIR/share:/usr/local/share:/usr/share"
xdg-user-dirs-update 2>/dev/null || true

# 5. Java — derive JAVA_HOME from the openjdk overlay so cytoscape.sh finds it.
_JAVA_BIN=$(command -v java 2>/dev/null)
if [ -n "$_JAVA_BIN" ]; then
    export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$_JAVA_BIN")")")"
    condatainer _server_message "Java: JAVA_HOME=$JAVA_HOME"
else
    condatainer _server_message "WARNING: java not found in PATH; Cytoscape may fail to start"
fi

# Cytoscape launcher wrapper — tricks Karaf's console stdin read into blocking
# forever by piping from sleep infinity.  Without a real TTY (Terminal=false),
# stdin would be EOF and the console thread would call shutdown immediately.
cat > "$CNT_JOB_TMPDIR/cytoscape-launch.sh" <<'EOF'
#!/bin/bash
exec 0< <(sleep infinity)
exec cytoscape
EOF
chmod +x "$CNT_JOB_TMPDIR/cytoscape-launch.sh"

# Cytoscape desktop entry.
mkdir -p "$CNT_JOB_TMPDIR/share/applications"
cat > "$CNT_JOB_TMPDIR/share/applications/cytoscape.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Cytoscape
Comment=Network Biology Visualization Platform
Exec=$CNT_JOB_TMPDIR/cytoscape-launch.sh
Terminal=false
Categories=Science;Biology;
EOF

# region Provider: kasm
if [ "$VNC_PROVIDER" = "kasm" ]; then

    KASM_INTERNAL_PORT=$(condatainer _pick_port)
    [ "$KASM_INTERNAL_PORT" = "$CNT_HELPER_PORT" ] && KASM_INTERNAL_PORT=$(condatainer _pick_port)

    # KasmVNC config.
    mkdir -p "$HOME/.vnc"
    cat > "$HOME/.vnc/kasmvnc.yaml" <<EOT
network:
  protocol: http
  interface: 127.0.0.1
  websocket_port: $KASM_INTERNAL_PORT
  ssl:
    require_ssl: false
EOT
    # kasmtech/KasmVNC#330: vncserver script hardcodes ~/.kasmpasswd regardless of
    # kasm_password_file config and prompts interactively if no write-access user exists.
    # Auth is disabled (-SecurityTypes None), so this dummy entry has no security impact.
    [ -f "$HOME/.kasmpasswd" ] || echo "${USER}::wo" > "$HOME/.kasmpasswd"

    # GPU detection — only enable hw3d if NVIDIA EGL is available (fails on MIG).
    DRI_NODE=$(ls /dev/dri/renderD* 2>/dev/null | head -1)
    if [ -n "$DRI_NODE" ]; then
        if EGL_PLATFORM=device eglinfo 2>/dev/null | grep -q "EGL vendor.*NVIDIA"; then
            cat >> "$HOME/.vnc/kasmvnc.yaml" <<EOT
desktop:
  gpu:
    hw3d: true
    drinode: $DRI_NODE
EOT
            condatainer _server_message "GPU: using $DRI_NODE for hardware acceleration"
        else
            condatainer _server_message "GPU: DRI node found but NVIDIA EGL unavailable (MIG?), using software rendering"
        fi
    fi

    # PulseAudio — null sink for browser audio streaming.
    # Minimal config (-n -F) avoids loading dbus-dependent modules (module-console-kit,
    # module-systemd-login) which fail on nodes without a system D-Bus socket.
    export PULSE_RUNTIME_PATH="$XDG_RUNTIME_DIR/pulse"
    mkdir -p "$PULSE_RUNTIME_PATH"
    export PULSE_SERVER="unix:$PULSE_RUNTIME_PATH/native"
    if command -v pulseaudio >/dev/null 2>&1; then
        cat > "$CNT_HELPER_STATE_DIR/pulse.pa" <<EOT
load-module module-native-protocol-unix auth-anonymous=1 socket=${PULSE_RUNTIME_PATH}/native
load-module module-null-sink sink_name=auto_null
set-default-sink auto_null
EOT
        pulseaudio --daemonize=yes --exit-idle-time=-1 --disallow-exit --disable-shm=true \
            -n -F "$CNT_HELPER_STATE_DIR/pulse.pa" \
            --log-target=file:"$CNT_HELPER_STATE_DIR/pulseaudio.log" 2>/dev/null || true
        for _i in $(seq 1 10); do pactl info >/dev/null 2>&1 && break; sleep 0.5; done
        _found=0
        for _i in $(seq 1 4); do
            pactl list sources short 2>/dev/null | grep -q "auto_null.monitor" && { _found=1; break; }
            sleep 0.5
        done
        [ "$_found" -eq 0 ] && condatainer _server_message "WARNING: auto_null.monitor not confirmed; browser audio may not work."
    else
        condatainer _server_message "WARNING: pulseaudio not found; browser audio will be unavailable."
    fi

    # Cleanup trap.
    KCLIENT_PID=""
    cleanup() {
        pulseaudio --kill >/dev/null 2>&1 || true
        [ -n "$KCLIENT_PID" ] && kill "$KCLIENT_PID" 2>/dev/null || true
        rm -f "/tmp/.X${DISPLAY_NUM}-lock" "/tmp/.X11-unix/X${DISPLAY_NUM}"
        exit 0
    }
    trap cleanup SIGINT SIGTERM

    # Start KasmVNC — try displays in order; a failed attempt (e.g. lost a race
    # with another launch for the same display) just advances to the next
    # candidate instead of aborting.
    DISPLAY_NUM=""
    for i in $(seq 10 999); do
        [ -f "/tmp/.X${i}-lock" ] && continue
        _port_open $((5900 + i)) && continue
        if { echo "=== attempt :${i} $(date) ==="; vncserver ":${i}" \
                -select-de manual \
                -xstartup "$CNT_HELPER_STATE_DIR/xstartup" \
                -SecurityTypes None \
                -disableBasicAuth \
                -PublicIP 127.0.0.1; } >>"$CNT_HELPER_STATE_DIR/vncserver.log" 2>&1; then
            DISPLAY_NUM=$i
            break
        fi
        rm -f "/tmp/.X${i}-lock" "/tmp/.X11-unix/X${i}"
    done
    if [ -z "$DISPLAY_NUM" ]; then
        condatainer _server_message "ERROR: No free X display found (tried :10-:999)"
        exit 1
    fi
    export DISPLAY=":${DISPLAY_NUM}"

    for _i in $(seq 1 20); do
        _port_open "$KASM_INTERNAL_PORT" && break
        sleep 0.5
    done

    # Start kclient.
    LISTEN_PORT="$CNT_HELPER_PORT" \
    KASM_WS_PORT="$KASM_INTERNAL_PORT" \
    FM_HOME="${SCRATCH:-$HOME}" \
    CUSTOM_USER="$(whoami)" \
        node /opt/kclient/index.js &
    KCLIENT_PID=$!

    for _i in $(seq 1 20); do
        _port_open "$CNT_HELPER_PORT" && break
        sleep 0.5
    done

    "$CNT_JOB_TMPDIR/cytoscape-launch.sh" &
    condatainer _server_ready --port "$CNT_HELPER_PORT" --url-path "/"
# endregion
else
# region Provider: turbo

    export PATH="/opt/TurboVNC/bin:/opt/VirtualGL/bin:$PATH"

    # VNC password.
    mkdir -p "$HOME/.vnc"
    VNC_PASSWD=$(openssl rand -base64 6 2>/dev/null || echo "cyto$(date +%s | tail -c4)")
    printf '%s\n%s\n' "$VNC_PASSWD" "$VNC_PASSWD" | vncpasswd -f > "$HOME/.vnc/passwd"
    chmod 600 "$HOME/.vnc/passwd"

    # Cleanup trap.
    WEBSOCKIFY_PID=""
    cleanup() {
        vncserver -kill "$DISPLAY" >/dev/null 2>&1 || true
        [ -n "$WEBSOCKIFY_PID" ] && kill "$WEBSOCKIFY_PID" 2>/dev/null || true
        rm -f "/tmp/.X${DISPLAY_NUM}-lock" "/tmp/.X11-unix/X${DISPLAY_NUM}"
        exit 0
    }
    trap cleanup SIGINT SIGTERM

    # Start TurboVNC — try displays in order; a failed attempt (e.g. lost a race
    # with another launch for the same display) just advances to the next
    # candidate instead of aborting.
    DISPLAY_NUM=""
    for i in $(seq 10 999); do
        [ -f "/tmp/.X${i}-lock" ] && continue
        VNC_PORT=$((5900 + i))
        _port_open "$VNC_PORT" && continue
        if { echo "=== attempt :${i} $(date) ==="; vncserver ":${i}" \
                -geometry 1600x900 \
                -depth 24 \
                -rfbport "$VNC_PORT" \
                -rfbauth "$HOME/.vnc/passwd" \
                -xstartup "$CNT_HELPER_STATE_DIR/xstartup"; } >>"$CNT_HELPER_STATE_DIR/vncserver.log" 2>&1; then
            DISPLAY_NUM=$i
            break
        fi
        rm -f "/tmp/.X${i}-lock" "/tmp/.X11-unix/X${i}"
    done
    if [ -z "$DISPLAY_NUM" ]; then
        condatainer _server_message "ERROR: No free X display found (tried :10-:999)"
        exit 1
    fi
    export DISPLAY=":${DISPLAY_NUM}"

    # Start websockify (noVNC WebSocket bridge).
    websockify --web /usr/share/novnc \
        "${CNT_HELPER_BIND_ADDR:-127.0.0.1}:$CNT_HELPER_PORT" \
        127.0.0.1:"$VNC_PORT" &
    WEBSOCKIFY_PID=$!

    "$CNT_JOB_TMPDIR/cytoscape-launch.sh" &
    condatainer _server_ready \
        --port "$CNT_HELPER_PORT" \
        --url-path "vnc.html?autoconnect=1&resize=remote&password=${VNC_PASSWD}"

# endregion
fi

sleep infinity
