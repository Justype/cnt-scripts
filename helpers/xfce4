#!/bin/bash
#WHATIS: XFCE4 desktop (TurboVNC/VirtualGL)
#NCPUS: 3
#MEM: 12G
#TIME: 8:00:00
#REQUIRED_OVERLAYS: xfce4
#BIND: $CNT_HELPER_STATE_DIR/vnc:$HOME/.vnc

# TurboVNC and VirtualGL install to /opt
export PATH="/opt/TurboVNC/bin:/opt/VirtualGL/bin:$PATH"

# Desktop dirs always under SCRATCH to protect HOME quota.
DESKTOP_HOME="${SCRATCH:-$HOME}/desktop-home"

# 1. Redirect all XDG user dirs to SCRATCH-based desktop home.
mkdir -p "$HOME/.config"
cat > "$HOME/.config/user-dirs.dirs" <<EOT
XDG_DESKTOP_DIR="$DESKTOP_HOME/Desktop"
XDG_DOCUMENTS_DIR="$DESKTOP_HOME/Documents"
XDG_DOWNLOAD_DIR="$DESKTOP_HOME/Downloads"
XDG_MUSIC_DIR="$DESKTOP_HOME/Music"
XDG_PICTURES_DIR="$DESKTOP_HOME/Pictures"
XDG_PUBLICSHARE_DIR="$DESKTOP_HOME/Public"
XDG_TEMPLATES_DIR="$DESKTOP_HOME/Templates"
XDG_VIDEOS_DIR="$DESKTOP_HOME/Videos"
EOT
mkdir -p "$DESKTOP_HOME"/{Desktop,Documents,Downloads,Music,Pictures,Public,Templates,Videos}

# 2. VNC password (standard VNC format for TurboVNC).
mkdir -p "$HOME/.vnc"
VNC_PASSWD=$(openssl rand -base64 6 2>/dev/null || echo "xfce$(date +%s | tail -c4)")
printf '%s\n%s\n' "$VNC_PASSWD" "$VNC_PASSWD" | vncpasswd -f > "$HOME/.vnc/passwd"
chmod 600 "$HOME/.vnc/passwd"

# 3. xstartup — per-id in state dir.
cat > "$CNT_HELPER_STATE_DIR/xstartup" <<'EOF'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
exec dbus-launch --exit-with-session startxfce4
EOF
chmod +x "$CNT_HELPER_STATE_DIR/xstartup"

# 4. Find free DISPLAY via lock files (robust on multi-user nodes).
DISPLAY_NUM=""
for i in $(seq 10 99); do
    [ ! -f "/tmp/.X${i}-lock" ] && { DISPLAY_NUM=$i; break; }
done
if [ -z "$DISPLAY_NUM" ]; then
    condatainer _server_message "ERROR: No free X display found (tried :10–:99)"
    exit 1
fi
export DISPLAY=":${DISPLAY_NUM}"
VNC_PORT=$((5900 + DISPLAY_NUM))

# 5. XDG_RUNTIME_DIR — per-id to avoid dbus conflicts between sessions.
# CNT_JOB_TMPDIR => scheduler TMPDIR or /tmp/$$
export XDG_RUNTIME_DIR="$CNT_JOB_TMPDIR/xdg_runtime"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# 6. Cleanup trap — stop VNC and websockify on exit.
WEBSOCKIFY_PID=""
cleanup() {
    vncserver -kill "$DISPLAY" >/dev/null 2>&1 || true
    [ -n "$WEBSOCKIFY_PID" ] && kill "$WEBSOCKIFY_PID" 2>/dev/null || true
    rm -f "/tmp/.X${DISPLAY_NUM}-lock" "/tmp/.X11-unix/X${DISPLAY_NUM}"
    exit 0
}
trap cleanup SIGINT SIGTERM

# 7. glib schemas — compile into per-job share dir (wiped by Slurm/cleanup; avoids quota).
SCHEMA_DIR="$CNT_JOB_TMPDIR/share/glib-2.0/schemas"
mkdir -p "$SCHEMA_DIR"
cp -r /usr/share/glib-2.0/schemas/* "$SCHEMA_DIR/" 2>/dev/null || true
glib-compile-schemas "$SCHEMA_DIR" 2>/dev/null || true
export XDG_DATA_DIRS="$CNT_JOB_TMPDIR/share:/usr/local/share:/usr/share"
xdg-user-dirs-update 2>/dev/null || true

# 8. Start TurboVNC.
vncserver "$DISPLAY" \
    -geometry 1600x900 \
    -depth 24 \
    -rfbport "$VNC_PORT" \
    -rfbauth "$HOME/.vnc/passwd" \
    -xstartup "$CNT_HELPER_STATE_DIR/xstartup"

# 9. Start websockify (noVNC WebSocket bridge).
websockify --web /usr/share/novnc \
    "${CNT_HELPER_BIND_ADDR:-127.0.0.1}:$CNT_HELPER_PORT" \
    127.0.0.1:"$VNC_PORT" &
WEBSOCKIFY_PID=$!

condatainer _server_ready \
    --port "$CNT_HELPER_PORT" \
    --url-path "vnc.html?autoconnect=1&resize=remote#password=${VNC_PASSWD}"

sleep infinity
