#PL:version:4.6.1
#AUTOUPDATE:version:docker:posit/r-base:^(\d+\.\d+\.\d+)-noble(?:-[^-]+)?$>=3.1.3
#TARGET:ubuntu24/r{version}
#WHATIS: Ubuntu noble R {version}
Bootstrap: docker
From: posit/r-base:{version}-noble

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PS1='CNT \w> '

%runscript
  exec /usr/bin/R "$@"
