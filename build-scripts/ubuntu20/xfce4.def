Bootstrap: docker
From: ubuntu:20.04

%labels
    Author Ziyue Cheng
    Version 1.0
    Description "Ubuntu20 with XFCE4 desktop"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PS1='CNT \w> '

%runscript
    exec /bin/bash "$@"	

%post
    # Avoid interactive prompts
    export DEBIAN_FRONTEND=noninteractive

    apt-get -y update

    # Desktop
    # XFCE4 and some useful tools
    # xfce4-terminal: terminal emulator
    # mousepad: text editor
    # xfce4-screenshooter: screenshot tool
    # ristretto: image viewer
    # xfce4-whiskermenu-plugin: start menu
    # vlc: media player
    # audacious: music player
    # diodon: clipboard manager
    # drawing: simple drawing tool
    apt-get -y install dbus-x11 pulseaudio ffmpeg xfce4 \
        xfce4-terminal mousepad xfce4-screenshooter \
        ristretto xfce4-whiskermenu-plugin \
        vlc audacious diodon drawing \
        fonts-noto-cjk

    # FireFox
    apt-get -y install software-properties-common
    add-apt-repository -y ppa:mozillateam/ppa
    apt-get -y install firefox-esr

    # TurboVNC (GPU-accelerated VNC server)
    apt-get -y install ca-certificates curl
    ARCH=$(dpkg --print-architecture)
    curl -fsSL \
        -o /tmp/turbovnc.deb \
        "https://github.com/TurboVNC/turbovnc/releases/download/3.3/turbovnc_3.3_${ARCH}.deb"
    apt-get -y install /tmp/turbovnc.deb
    rm -f /tmp/turbovnc.deb

    # VirtualGL (OpenGL GPU offload for VNC; provides vglrun)
    curl -fsSL \
        -o /tmp/virtualgl.deb \
        "https://github.com/VirtualGL/virtualgl/releases/download/3.1.4/virtualgl_3.1.4_${ARCH}.deb"
    apt-get -y install /tmp/virtualgl.deb
    rm -f /tmp/virtualgl.deb

    # noVNC + websockify (browser VNC client / WebSocket bridge)
    apt-get -y install novnc python3-websockify

    # KasmVNC (browser-based VNC alternative with built-in WebSocket)
    KASMVNC_VERSION="1.4.0"
    curl -fsSL \
        -o /tmp/kasmvnc.deb \
        "https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_focal_${KASMVNC_VERSION}_${ARCH}.deb"
    apt-get -y install /tmp/kasmvnc.deb
    rm -f /tmp/kasmvnc.deb

    # Node.js 22 + kclient (KasmVNC audio streaming via PulseAudio)
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get install -y nodejs build-essential pkg-config libpulse-dev git
    git clone https://github.com/Justype/kclient.git /opt/kclient
    cd /opt/kclient && npm install --omit=dev

    # NVIDIA EGL ICD for Apptainer --nv: tells libEGL where to find the NVIDIA
    # implementation injected at runtime into /.singularity.d/libs/.
    mkdir -p /usr/share/glvnd/egl_vendor.d
    cat > /usr/share/glvnd/egl_vendor.d/10_nvidia.json <<'NVJSON'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "libEGL_nvidia.so.0"
    }
}
NVJSON

    # OpenGL/Vulkan/OpenCL — software rendering fallback + scientific viz deps + diagnostics
    apt-get -y install \
        libgl1-mesa-dri libglu1-mesa libglew2.1 freeglut3 libosmesa6 libegl-mesa0 \
        mesa-utils \
        libvulkan1 mesa-vulkan-drivers vulkan-tools \
        ocl-icd-libopencl1 pocl-opencl-icd clinfo

    apt-get clean && rm -rf /var/lib/apt/lists/*

    # xorg settings
    echo "allowed_users = anybody" >> /etc/X11/Xwrapper.config
