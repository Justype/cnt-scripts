#!/usr/bin/bash
#PL:cytoscape_version:3.9.0,3.9.1,3.10.0,3.10.1,3.10.2,3.10.3,3.10.4
#AUTOUPDATE:cytoscape_version:github:cytoscape/cytoscape>=3.9.0
#TARGET:cytoscape/{cytoscape_version}
#WHATIS:Cytoscape {cytoscape_version} — network biology visualization platform (needs Java)
#URL:https://github.com/cytoscape/cytoscape/releases

#########################################################
# Cytoscape build script
# - Downloads the official pre-built Linux binary from GitHub releases
# - Requires Java (openjdk) to run
#########################################################

install_app() {
    local url="https://github.com/cytoscape/cytoscape/releases/download/{cytoscape_version}/cytoscape-unix-{cytoscape_version}.tar.gz"

    print_stderr "Downloading ${YELLOW}${app_name_cytoscape_version}${NC}"
    curl -fsSL -o "cytoscape.tar.gz" "$url"

    print_stderr "Extracting ${YELLOW}${app_name_cytoscape_version}${NC}"
    tar --no-same-owner -xzf cytoscape.tar.gz -C "$target_dir" --strip-components=1

    mkdir -p "$target_dir/bin"
    ln -s "$target_dir/cytoscape.sh" "$target_dir/bin/cytoscape"
}

# Available variables:
# - NCPUS: number of cores to use (default: 4; set by condatainer)
# - app_name:         name     of the app (set by condatainer)
# - cytoscape_version:          cytoscape_version  of the app (set by condatainer)
# - app_name_cytoscape_version: name/cytoscape_version        (set by condatainer)

# - target_dir:       opt/name/cytoscape_version (set by condatainer)
# - tmp_dir:          tmp directory (set by condatainer)

# region common_functions
set -e # exit on error
RED='\033[0;91m'    # Red      WARNING or ERROR
BLUE='\033[0;94m'   # Blue     Dependency or Modulefile Changes
YELLOW='\033[0;93m' # Yellow   App Name and/or Version
NC='\033[0m'        # No Color
NCPUS=${NCPUS:-4}   # number of cores to use when building from source

install() {
    print_stderr "Installing the target module: ${YELLOW}${app_name_cytoscape_version}${NC}"
    print_stderr "🎯 Target directory: $target_dir"
    if [ -d "$target_dir" ]; then
        print_stderr "${RED}ERROR${NC}: Target app dir exists!"
        print_stderr "Exit Installing"
        exit 1
    fi

    if [[ -z "$tmp_dir" ]]; then
        print_stderr "${RED}ERROR${NC}: tmp_dir is not set!"
        print_stderr "Exit Installing"
        exit 1
    fi

    if [[ -z "$target_dir" ]]; then
        print_stderr "${RED}ERROR${NC}: target_dir is not set!"
        print_stderr "Exit Installing"
        exit 1
    fi

    mkdir -p "$target_dir"
    mkdir -p "$tmp_dir"
    cd "$tmp_dir"
    install_app
    print_stderr "✅ Installation completed. ${YELLOW}${app_name_cytoscape_version}${NC} is ready to use."
}

print_stderr() {
    printf "[`date +"%Y-%m-%d %T"`] $1\n" 1>&2
}

pigz_or_gunzip() {
    if command -v pigz &> /dev/null; then
        pigz -d -p $NCPUS "$1"
    else
        gunzip "$1"
    fi
}

pigz_or_gunzip_pipe() {
    if command -v pigz &> /dev/null; then
        pigz -d -p $NCPUS -c "$1"
    else
        gunzip -c "$1"
    fi
}

tar_xf_pigz() {
    if command -v pigz &> /dev/null; then
        tar --no-same-owner --use-compress-program="pigz -d -p $NCPUS" -xf "$@"
    else
        tar --no-same-owner -xzf "$@"
    fi
}
#endregion

install
